.{
    // Paths to exclude from indexation.
    .exclude_paths = .{ "zig-cache", "zig-out", ".git", "target" },

    // Storage configuration.
    .storage = .{
        .path = ".zcodeprism/",
        .format = .binary,
    },

    // Memory budget.
    .memory = .{
        .budget_mb = 512,
    },
}
